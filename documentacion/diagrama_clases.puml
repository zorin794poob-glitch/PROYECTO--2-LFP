@startuml
skinparam classAttributeIconSize 0
class Main { -editor: JTextArea -salida: JTextArea -panelErrores: JTextArea +main(args) }
class Lexer { -s: String +tokenizar(): List<Token> }
class Token { +tipo: String +lexema: String +fila: int +columna: int }
class Parser { -ts: List<Token> +analizar(): Modelo }
class Compilador { +compilar(fuente) +generarPrompt() +reporteErrores() +reporteSimbolos() +reporteAst() }
class Modelo { +directivas: List<Directiva> +agentes: List<Agente> +ejecuciones: List<String> +exportaciones: List<String> }
class Agente { +nombre: String +contexto: String +variables: List<Variable> +comandos: List<Comando> }
class Variable { +nombre: String +valor: Expr +tipo: String }
class Comando { +tipo: String +argumento: Expr +conectores: List<String> +destino: String }
class Expr { +tipo: String +valor: String +partes: List<Expr> }
class ErrorCompilacion { +tipo: String +descripcion: String +fila: int +columna: int }
Main --> Compilador
Compilador --> Lexer
Compilador --> Parser
Lexer --> Token
Parser --> Token
Parser --> Modelo
Modelo "1" o-- "*" Agente
Modelo "1" o-- "*" Directiva
Agente "1" o-- "*" Variable
Agente "1" o-- "*" Comando
Variable --> Expr
Comando --> Expr
Compilador --> ErrorCompilacion
@enduml
